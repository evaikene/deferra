cmake_minimum_required(VERSION 3.20)

set(producer_source [==[@PROJECT_SOURCE_DIR@]==])
set(producer_build [==[@PROJECT_BINARY_DIR@]==])
set(sdk_directory [==[@JOBU_INSTALL_CMAKEDIR@]==])
set(sdk_components [==[@JOBU_SDK_COMPONENTS@]==])
set(include_directory [==[@CMAKE_INSTALL_INCLUDEDIR@]==])
set(library_directory [==[@CMAKE_INSTALL_LIBDIR@]==])
set(data_directory [==[@CMAKE_INSTALL_DATADIR@]==])
foreach(directory sdk_directory include_directory library_directory data_directory)
    if(IS_ABSOLUTE "${${directory}}" OR "${${directory}}" MATCHES "(^|/)[.][.](/|$)")
        message(STATUS "Unsupported SDK-test layout: ${directory} is not prefix-relative")
        return()
    endif()
endforeach()

execute_process(COMMAND mktemp -d /tmp/jobu-sdk.XXXXXX
    RESULT_VARIABLE status OUTPUT_VARIABLE fixture OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0 OR fixture STREQUAL "")
    message(FATAL_ERROR "private SDK fixture creation failed")
endif()
set(prefix "${fixture}/prefix")
set(consumer_source "${fixture}/consumer")
file(COPY "${producer_source}/test/sdk-consumer/" DESTINATION "${consumer_source}")

function(run_checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${fixture}/${label}.log" "${output}\n${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label} failed (${result}); evidence: ${fixture}\n${output}\n${error}")
    endif()
endfunction()

set(install_arguments --install "${producer_build}" --prefix "${prefix}" --component Development)
if(NOT "${test_configuration}" STREQUAL "")
    list(APPEND install_arguments --config "${test_configuration}")
endif()
run_checked(install "@CMAKE_COMMAND@" ${install_arguments})

# Producer-only dependency discovery is forbidden even when installed locally.
# These switches turn accidental REQUIRED discovery into a configure failure.
function(configure_consumer label case sdk expect_error)
    set(initial_cache "${fixture}/${label}-cache.cmake")
    file(READ "@CMAKE_CURRENT_BINARY_DIR@/jobu-sdk-cache.cmake" cache)
    string(APPEND cache "\nset(CMAKE_PREFIX_PATH [==[${sdk};@CMAKE_PREFIX_PATH@]==] CACHE STRING \"\" FORCE)\n")
    string(APPEND cache "set(SDK_PREFIX [==[${sdk}]==] CACHE PATH \"\" FORCE)\n")
    string(APPEND cache "set(SDK_FORBIDDEN_PATHS [==[${producer_source};${producer_build}]==] CACHE STRING \"\" FORCE)\n")
    if(NOT sdk STREQUAL prefix)
        string(APPEND cache "list(APPEND SDK_FORBIDDEN_PATHS [==[${prefix}]==])\n")
    endif()
    if(NOT case STREQUAL "SQLite" AND NOT case STREQUAL "missing-sqlite")
        string(APPEND cache "set(CMAKE_DISABLE_FIND_PACKAGE_SQLite3 TRUE CACHE BOOL \"\" FORCE)\n")
    endif()
    if(NOT case STREQUAL "HTTP")
        string(APPEND cache "set(CMAKE_DISABLE_FIND_PACKAGE_CURL TRUE CACHE BOOL \"\" FORCE)\n")
    endif()
    file(WRITE "${initial_cache}" "${cache}")

    set(build "${fixture}/build-${label}")
    set(source "${consumer_source}")
    if(case STREQUAL "example")
        set(source "${sdk}/${data_directory}/jobu/examples/jobu-client")
    endif()
    set(arguments -S "${source}" -B "${build}" -G "@CMAKE_GENERATOR@"
        -C "${initial_cache}" "-DSDK_CASE=${case}")
    if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
        list(APPEND arguments -A "@CMAKE_GENERATOR_PLATFORM@")
    endif()
    if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
        list(APPEND arguments -T "@CMAKE_GENERATOR_TOOLSET@")
    endif()
    execute_process(COMMAND "@CMAKE_COMMAND@" ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${fixture}/${label}-configure.log" "${output}\n${error}")
    if(NOT expect_error STREQUAL "")
        if(result EQUAL 0 OR NOT "${output}\n${error}" MATCHES "${expect_error}")
            message(FATAL_ERROR "${label}: expected ${expect_error}; evidence: ${fixture}\n${output}\n${error}")
        endif()
        return()
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label} configuration failed; evidence: ${fixture}\n${output}\n${error}")
    endif()

    set(configuration_arguments)
    set(ctest_arguments)
    if(NOT "${test_configuration}" STREQUAL "")
        list(APPEND configuration_arguments --config "${test_configuration}")
        list(APPEND ctest_arguments -C "${test_configuration}")
    endif()
    run_checked("${label}-build" "@CMAKE_COMMAND@" --build "${build}" ${configuration_arguments} --parallel 2)
    if(NOT case STREQUAL "example")
        run_checked("${label}-run" "@CMAKE_CTEST_COMMAND@" --test-dir "${build}" ${ctest_arguments} --output-on-failure)
    endif()

    # Compilation and final link commands must agree with the imported-property
    # audit. Absolute debug/source-location strings inside archives are not paths
    # used to discover headers or satisfy the consumer's link dependencies.
    file(GLOB_RECURSE link_commands "${build}/CMakeFiles/*/link.txt")
    set(command_files "${build}/compile_commands.json" ${link_commands})
    if(EXISTS "${build}/build.ninja")
        list(APPEND command_files "${build}/build.ninja")
    endif()
    foreach(command_file IN LISTS command_files)
        file(READ "${command_file}" commands)
        foreach(forbidden "${producer_source}" "${producer_build}")
            string(FIND "${commands}" "${forbidden}" position)
            if(NOT position EQUAL -1)
                message(FATAL_ERROR "${label}: command uses producer path ${forbidden}; evidence: ${fixture}")
            endif()
        endforeach()
    endforeach()
endfunction()

set(cases default Core Shared Client CLI discovery optional-http example)
if("SQLite" IN_LIST sdk_components)
    list(APPEND cases SQLite)
endif()
if("HTTP" IN_LIST sdk_components)
    list(APPEND cases HTTP)
endif()
foreach(case IN LISTS cases)
    configure_consumer("original-${case}" "${case}" "${prefix}" "")
endforeach()
configure_consumer(unknown unknown "${prefix}" "Unknown JobU component: Unknown")
configure_consumer(version version "${prefix}" "0[.]2[.]0")

# Missing optional exports must fail as a package lookup, not leave a dangling
# imported target. An actual SQLite-disabled producer is also checked separately.
set(without_sqlite "${fixture}/without-sqlite")
file(COPY "${prefix}/" DESTINATION "${without_sqlite}")
file(REMOVE "${without_sqlite}/${sdk_directory}/JobUSQLiteTargets.cmake")
configure_consumer(missing-sqlite missing-sqlite "${without_sqlite}" "SQLite was not built or installed")
configure_consumer(optional optional "${without_sqlite}" "")

# Move the original out of reach after copying. This catches an export which
# appeared relocatable only because the original installation was still usable.
set(relocated "${fixture}/relocated SDK")
file(COPY "${prefix}/" DESTINATION "${relocated}")
file(RENAME "${prefix}" "${fixture}/original-unavailable")
foreach(case IN LISTS cases)
    configure_consumer("relocated-${case}" "${case}" "${relocated}" "")
endforeach()

message(STATUS "Installed and relocated SDK consumers passed; evidence: ${fixture}")
