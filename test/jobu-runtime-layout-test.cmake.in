cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED fixture OR NOT DEFINED test_logs)
    message(FATAL_ERROR "Run through jobu-test-runner.cmake")
endif()
include("@CMAKE_CURRENT_BINARY_DIR@/jobu-install-manifest.cmake")
execute_process(COMMAND id -u OUTPUT_VARIABLE installer_uid OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND id -g OUTPUT_VARIABLE installer_gid OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)

function(configure_layout name prefix)
    execute_process(COMMAND "@CMAKE_COMMAND@" -S "@PROJECT_SOURCE_DIR@/test/systemd-fixture"
        -B "${fixture}/${name}" -G "@CMAKE_GENERATOR@" "-Djobu_source=@PROJECT_SOURCE_DIR@"
        "-DCMAKE_INSTALL_PREFIX=${prefix}" -DJB_JOBU_SYSTEMD_PROFILE=none ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${test_logs}/${name}-configure.log" "${output}\n${error}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${name} configuration failed: ${output}\n${error}")
    endif()
endfunction()

function(install_layout name prefix component staging expected_result)
    set(arguments --install "${fixture}/${name}" --prefix "${prefix}")
    if(NOT component STREQUAL "")
        list(APPEND arguments --component "${component}")
    endif()
    # A permissive umask exposes accidental reliance on the caller's environment.
    execute_process(COMMAND "@CMAKE_COMMAND@" -E env "DESTDIR=${staging}"
        /bin/sh -c "umask 000; exec \"$@\"" sh "@CMAKE_COMMAND@" ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(APPEND "${test_logs}/${name}-install.log" "${output}\n${error}")
    if(expected_result STREQUAL "success")
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "${name} install failed: ${output}\n${error}")
        endif()
    else()
        string(FIND "${output}${error}" "${expected_result}" position)
        if(result STREQUAL "0" OR position EQUAL -1)
            message(FATAL_ERROR "Expected refusal naming ${expected_result}: ${result}\n${output}\n${error}")
        endif()
    endif()
endfunction()

function(require_metadata path mode)
    read_metadata(metadata "${path}")
    if(NOT metadata STREQUAL "${mode}:${installer_uid}:${installer_gid}")
        message(FATAL_ERROR "Wrong installer-owned metadata for ${path}: ${metadata}")
    endif()
endfunction()

function(check_new_layout prefix)
    foreach(directory etc var)
        require_metadata("${prefix}/${directory}" 755)
    endforeach()
    foreach(directory var/lib var/run)
        require_metadata("${prefix}/${directory}" 700)
    endforeach()
    require_metadata("${prefix}/etc/README.md" 644)
    if(EXISTS "${prefix}/etc/jobud.ini" OR IS_SYMLINK "${prefix}/etc/jobud.ini")
        message(FATAL_ERROR "Installation created an active INI")
    endif()
endfunction()

# Use an actual configured asset prefix, with spaces and a shell quote. This is
# deliberately an asset fixture, not the fresh daemon-start acceptance in 9.34.
set(prefix "${fixture}/private prefix's")
configure_layout(default "${prefix}")
install_layout(default "${prefix}" "" "" success)
check_new_layout("${prefix}")
require_metadata("${prefix}" 755)
require_metadata("${fixture}" 700)
install_layout(default "${fixture}/runtime-only" Runtime "" success)
check_new_layout("${fixture}/runtime-only")
foreach(component Development Documentation)
    set(destination "${fixture}/${component}-only")
    install_layout(default "${destination}" "${component}" "" success)
    if(EXISTS "${destination}/etc" OR EXISTS "${destination}/var")
        message(FATAL_ERROR "${component} provisioned runtime directories")
    endif()
endforeach()

# Execute the first fenced command verbatim, rather than a test's imitation of
# the documented copy operation. A successful subshell must preserve outer umask.
file(READ "${prefix}/etc/README.md" guide)
string(REGEX MATCH "```sh\n([^`]+)```" copy_block "${guide}")
if(copy_block STREQUAL "")
    message(FATAL_ERROR "Configuration README has no initial-copy command")
endif()
set(copy_command "${CMAKE_MATCH_1}")
execute_process(COMMAND /bin/sh -c "umask 022; ${copy_command}\nresult=$?; [ \"$result\" = 0 ] && [ \"$(umask)\" = 0022 ]"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "README copy failed or leaked umask: ${output}\n${error}")
endif()
require_metadata("${prefix}/etc/jobud.ini" 600)
file(SHA256 "${prefix}/etc/jobud.ini" config_hash)
file(SHA256 "${prefix}/share/jobu/jobud.ini.example" sample_hash)
if(NOT config_hash STREQUAL sample_hash)
    message(FATAL_ERROR "README copy changed sample bytes")
endif()
execute_process(COMMAND /bin/sh -c "${copy_command}" RESULT_VARIABLE repeat_result ERROR_VARIABLE error)
if(repeat_result STREQUAL "0")
    message(FATAL_ERROR "README copy did not refuse existing configuration")
endif()

if(DEFINED jobud AND NOT jobud STREQUAL "")
    file(COPY "${jobud}" DESTINATION "${prefix}/bin")
    string(REGEX MATCH "```sh\n([^`]+--check-config[^`]+)```" check_block "${guide}")
    if(check_block STREQUAL "")
        message(FATAL_ERROR "README has no configuration-check command")
    endif()
    execute_process(COMMAND /bin/sh -c "${CMAKE_MATCH_1}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0" OR NOT output MATCHES "Configuration valid:")
        message(FATAL_ERROR "README configuration check failed: ${output}\n${error}")
    endif()
endif()

# The README must also refuse symlinks without creating or changing their target.
file(RENAME "${prefix}/etc/jobud.ini" "${prefix}/etc/saved.ini")
set(copy_target "${fixture}/copy-target")
file(WRITE "${copy_target}" "preserved copy target\n")
foreach(kind existing dangling)
    set(link_target "${copy_target}")
    if(kind STREQUAL "dangling")
        set(link_target "${fixture}/absent-copy-target")
    endif()
    file(CREATE_LINK "${link_target}" "${prefix}/etc/jobud.ini" SYMBOLIC RESULT result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "README symlink fixture failed: ${result}")
    endif()
    execute_process(COMMAND /bin/sh -c "${copy_command}" RESULT_VARIABLE result ERROR_VARIABLE error)
    file(READ_SYMLINK "${prefix}/etc/jobud.ini" actual_target)
    if(result STREQUAL "0" OR NOT actual_target STREQUAL link_target)
        message(FATAL_ERROR "README copy changed or accepted an existing symlink")
    endif()
    if(kind STREQUAL "dangling" AND EXISTS "${link_target}")
        message(FATAL_ERROR "README copy created a dangling symlink's target")
    endif()
    file(REMOVE "${prefix}/etc/jobud.ini")
endforeach()
file(READ "${copy_target}" target_contents)
if(NOT target_contents STREQUAL "preserved copy target\n")
    message(FATAL_ERROR "README copy modified a symlink target")
endif()
file(RENAME "${prefix}/etc/saved.ini" "${prefix}/etc/jobud.ini")

# Preserve deliberately nondefault directory modes, private files and sidecars.
# The 0750 runtime leaf represents the existing administrator-group policy.
file(CHMOD "${prefix}" "${prefix}/etc" "${prefix}/var" "${prefix}/var/lib"
    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_EXECUTE)
file(CHMOD "${prefix}/var/run" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE)
set(preserved etc/jobud.ini var/lib/jobu.sqlite3 var/lib/jobu.sqlite3-wal var/lib/jobu.sqlite3-shm
    var/run/jobud.sock.lock var/run/unrelated.txt)
foreach(path IN LISTS preserved)
    if(NOT path STREQUAL "etc/jobud.ini")
        file(WRITE "${prefix}/${path}" "operator sentinel ${path}\n")
        file(CHMOD "${prefix}/${path}" PERMISSIONS OWNER_READ OWNER_WRITE)
    endif()
    file(SHA256 "${prefix}/${path}" "before_hash_${path}")
endforeach()
set(metadata_paths "" etc var var/lib var/run ${preserved})
foreach(path IN LISTS metadata_paths)
    read_metadata("before_metadata_${path}" "${prefix}/${path}")
endforeach()
foreach(pass RANGE 1 2)
    install_layout(default "${prefix}" Runtime "" success)
endforeach()
foreach(path IN LISTS metadata_paths)
    read_metadata(metadata "${prefix}/${path}")
    if(NOT metadata STREQUAL "${before_metadata_${path}}")
        message(FATAL_ERROR "Reinstall changed metadata for ${path}")
    endif()
endforeach()
foreach(path IN LISTS preserved)
    file(SHA256 "${prefix}/${path}" hash)
    if(NOT hash STREQUAL "${before_hash_${path}}")
        message(FATAL_ERROR "Reinstall changed operator bytes for ${path}")
    endif()
endforeach()

# Every known directory rejects regular files, directory symlinks and dangling
# symlinks. The target canary must remain untouched even for a var parent link.
set(target "${fixture}/collision-target")
file(MAKE_DIRECTORY "${target}")
file(WRITE "${target}/canary" "preserve target\n")
foreach(directory etc var var/lib var/run)
    foreach(kind file symlink dangling)
        string(REPLACE "/" "-" label "${directory}-${kind}")
        set(destination "${fixture}/collision-${label}")
        set(collision "${destination}/${directory}")
        get_filename_component(parent "${collision}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        if(kind STREQUAL "file")
            file(WRITE "${collision}" "preserve collision\n")
            file(SHA256 "${collision}" original_hash)
            read_metadata(original_metadata "${collision}")
        else()
            set(link_target "${target}")
            if(kind STREQUAL "dangling")
                set(link_target "${fixture}/absent-target-${label}")
            endif()
            file(CREATE_LINK "${link_target}" "${collision}" SYMBOLIC RESULT link_result)
            if(NOT link_result STREQUAL "0")
                message(FATAL_ERROR "Collision fixture link failed: ${link_result}")
            endif()
        endif()
        install_layout(default "${destination}" Runtime "" "${collision}")
        if(kind STREQUAL "file")
            file(SHA256 "${collision}" hash)
            read_metadata(metadata "${collision}")
            if(NOT hash STREQUAL original_hash OR NOT metadata STREQUAL original_metadata)
                message(FATAL_ERROR "Installation changed the collision")
            endif()
        else()
            file(READ_SYMLINK "${collision}" actual_target)
            if(NOT actual_target STREQUAL link_target)
                message(FATAL_ERROR "Installation changed the collision link")
            endif()
            if(kind STREQUAL "dangling" AND EXISTS "${link_target}")
                message(FATAL_ERROR "Installation followed a dangling collision")
            endif()
        endif()
    endforeach()
endforeach()
file(GLOB target_entries RELATIVE "${target}" "${target}/*")
file(READ "${target}/canary" contents)
if(NOT target_entries STREQUAL "canary" OR NOT contents STREQUAL "preserve target\n")
    message(FATAL_ERROR "Installation wrote through a directory symlink")
endif()

# A neighbouring prefix is external, not a string-prefix match. Staging also
# leaves all live custom resources alone, including a quoted configuration path.
set(external_prefix "${fixture}/external-prefix")
set(external_config "${fixture}/configuration 'and \"quotes")
set(external_state "${external_prefix}-neighbour/var/lib")
set(external_run "${fixture}/external-run")
foreach(path "${external_config}" "${external_state}" "${external_run}")
    file(MAKE_DIRECTORY "${path}")
    file(WRITE "${path}/canary" "live external sentinel\n")
    read_metadata("external_metadata_${path}" "${path}")
endforeach()
configure_layout(external "${external_prefix}" "-DJB_JOBU_SYSCONFDIR:STRING=${external_config}"
    "-DJB_JOBU_STATEDIR=${external_state}" "-DJB_JOBU_RUNDIR=${external_run}")
install_layout(external /opt/jobu-layout-stage Runtime "${fixture}/staging" success)
set(staged "${fixture}/staging/opt/jobu-layout-stage")
if(EXISTS "${staged}/etc" OR EXISTS "${staged}/var" OR EXISTS "${external_prefix}")
    message(FATAL_ERROR "External layout provisioned live or private runtime paths")
endif()
file(READ "${staged}/share/jobu/configuration-README.md" external_guide)
string(FIND "${external_guide}" "${external_config}/jobud.ini" config_position)
string(FIND "${external_guide}" "${fixture}/staging" staging_position)
if(config_position EQUAL -1 OR NOT staging_position EQUAL -1)
    message(FATAL_ERROR "External README lost compiled configuration or contains DESTDIR")
endif()
string(REGEX MATCH "```sh\n([^`]+)```" copy_block "${external_guide}")
set(external_copy "${CMAKE_MATCH_1}")
# The sample's compiled location is intentionally absent after staged installation.
# Supply only that source asset to execute the documented external-path example.
file(MAKE_DIRECTORY "${external_prefix}/share/jobu")
file(COPY "${staged}/share/jobu/jobud.ini.example" DESTINATION "${external_prefix}/share/jobu")
execute_process(COMMAND /bin/sh -c "${external_copy}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Quoted external README copy failed: ${error}")
endif()
require_metadata("${external_config}/jobud.ini" 600)
foreach(path "${external_config}" "${external_state}" "${external_run}")
    read_metadata(metadata "${path}")
    file(READ "${path}/canary" contents)
    if(NOT metadata STREQUAL "${external_metadata_${path}}" OR NOT contents STREQUAL "live external sentinel\n")
        message(FATAL_ERROR "Staging changed an external resource: ${path}")
    endif()
endforeach()

configure_layout(mixed "${fixture}/mixed-live" "-DJB_JOBU_STATEDIR=${external_state}")
install_layout(mixed "${fixture}/mixed-installed" Runtime "" success)
if(EXISTS "${fixture}/mixed-installed/var/lib" OR NOT IS_DIRECTORY "${fixture}/mixed-installed/var/run")
    message(FATAL_ERROR "Mixed defaults provisioned the wrong operational leaves")
endif()

configure_layout(external-config "${fixture}/external-config-live" "-DJB_JOBU_SYSCONFDIR:STRING=${external_config}")
install_layout(external-config "${fixture}/external-config-installed" Runtime "" success)
set(destination "${fixture}/external-config-installed")
if(EXISTS "${destination}/etc" OR NOT EXISTS "${destination}/share/jobu/configuration-README.md")
    message(FATAL_ERROR "External configuration claimed the private etc directory")
endif()
require_metadata("${destination}/var/lib" 700)
require_metadata("${destination}/var/run" 700)

configure_layout(external-runtime "${fixture}/external-runtime-live" "-DJB_JOBU_RUNDIR=${external_run}")
install_layout(external-runtime "${fixture}/external-runtime-installed" Runtime "" success)
set(destination "${fixture}/external-runtime-installed")
if(EXISTS "${destination}/var/run")
    message(FATAL_ERROR "External runtime path provisioned the private runtime leaf")
endif()
require_metadata("${destination}/etc/README.md" 644)
require_metadata("${destination}/var/lib" 700)
message(STATUS "Private modes, components, README commands, preservation, collisions and external staging passed")
