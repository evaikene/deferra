# Preserve the producer toolchain and external dependency hints, but never add
# its JobU targets or includes. Each fixture prepends its installed SDK prefix.
@JOBU_SDK_CONSUMER_CACHE@
set(CMAKE_EXPORT_COMPILE_COMMANDS TRUE CACHE BOOL "" FORCE)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY FALSE CACHE BOOL "" FORCE)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY FALSE CACHE BOOL "" FORCE)
set(CMAKE_FIND_PACKAGE_NO_PACKAGE_REGISTRY TRUE CACHE BOOL "" FORCE)
set(CMAKE_FIND_PACKAGE_NO_SYSTEM_PACKAGE_REGISTRY TRUE CACHE BOOL "" FORCE)
set(CMAKE_DISABLE_FIND_PACKAGE_Catch2 TRUE CACHE BOOL "" FORCE)
set(CMAKE_DISABLE_FIND_PACKAGE_nlohmann_json TRUE CACHE BOOL "" FORCE)
