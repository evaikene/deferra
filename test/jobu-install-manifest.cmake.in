# Shared expected payload, derived from the producer's explicit install manifests.
# Inventory generation must not become the oracle for which files belong here.
set(binary_directory [==[@CMAKE_INSTALL_BINDIR@]==])
set(library_directory [==[@CMAKE_INSTALL_LIBDIR@]==])
set(include_directory [==[@CMAKE_INSTALL_INCLUDEDIR@]==])
set(data_directory [==[@CMAKE_INSTALL_DATADIR@]==])
set(documentation_directory [==[@CMAKE_INSTALL_DOCDIR@]==])
set(sdk_directory [==[@JOBU_INSTALL_CMAKEDIR@]==])
set(installed_headers [==[@JOBU_INSTALL_HEADERS@]==])
set(libraries [==[@JOBU_INSTALL_LIBRARIES@]==])
set(applications [==[@JOBU_INSTALL_APPLICATIONS@]==])
set(protocol_manuals [==[@JOBU_PROTOCOL_MANUALS@]==])
set(manuals [==[@JOBU_MANUALS@]==])
set(sdk_components [==[@JOBU_SDK_COMPONENTS@]==])
if(NOT DEFINED systemd_profile)
    set(systemd_profile [==[@JB_JOBU_SYSTEMD_PROFILE@]==])
endif()

# Package fixtures compile their own /opt/jobu layout. Their expectations must
# describe that producer, rather than inherit a parent's external-path policy.
if(NOT DEFINED layout_configured_prefix)
    set(layout_configured_prefix [==[@CMAKE_INSTALL_PREFIX@]==])
    set(layout_config_directory [==[@JB_JOBU_SYSCONFDIR@]==])
    set(layout_state_directory [==[@JB_JOBU_STATEDIR@]==])
    set(layout_runtime_directory [==[@JB_JOBU_RUNDIR@]==])
endif()
set(runtime_directories "")
set(configuration_readme "${data_directory}/jobu/configuration-README.md")
if(layout_config_directory STREQUAL "${layout_configured_prefix}/etc")
    list(APPEND runtime_directories etc)
    set(configuration_readme etc/README.md)
endif()
if(layout_state_directory STREQUAL "${layout_configured_prefix}/var/lib"
    OR layout_runtime_directory STREQUAL "${layout_configured_prefix}/var/run")
    list(APPEND runtime_directories var)
endif()
if(layout_state_directory STREQUAL "${layout_configured_prefix}/var/lib")
    list(APPEND runtime_directories var/lib)
endif()
if(layout_runtime_directory STREQUAL "${layout_configured_prefix}/var/run")
    list(APPEND runtime_directories var/run)
endif()

set(common_files "${data_directory}/jobu/LICENSE" "${data_directory}/jobu/THIRD_PARTY_NOTICES.md")
set(runtime_files ${common_files}
    "${configuration_readme}"
    "${data_directory}/jobu/jobud.ini.example"
    "${data_directory}/jobu/services/jobud.service.in" "${data_directory}/jobu/services/README.md"
    "${data_directory}/jobu/services/wait-ready.sh"
    "${data_directory}/jobu/package/build-info-runtime.txt")
if(NOT systemd_profile STREQUAL "none")
    list(APPEND runtime_files "${data_directory}/jobu/services/jobud.service")
endif()
if(systemd_profile STREQUAL "system")
    list(APPEND runtime_files "lib/systemd/system/jobud.service")
endif()
foreach(application IN LISTS applications)
    list(APPEND runtime_files "${binary_directory}/${application}@CMAKE_EXECUTABLE_SUFFIX@")
endforeach()
set(development_files ${common_files}
    "${data_directory}/jobu/package/build-info-development.txt"
    "${sdk_directory}/JobUConfig.cmake" "${sdk_directory}/JobUConfigVersion.cmake"
    "${data_directory}/jobu/examples/jobu-client/CMakeLists.txt"
    "${data_directory}/jobu/examples/jobu-client/main.cpp"
    "${data_directory}/jobu/examples/jobu-client/idempotent_creation.cpp")
string(TOLOWER "${test_configuration}" sdk_configuration)
if(sdk_configuration STREQUAL "")
    set(sdk_configuration noconfig)
endif()
foreach(component IN LISTS sdk_components)
    list(APPEND development_files "${sdk_directory}/JobU${component}Targets.cmake"
        "${sdk_directory}/JobU${component}Targets-${sdk_configuration}.cmake")
endforeach()
foreach(library IN LISTS libraries)
    list(APPEND development_files "${library_directory}/@CMAKE_STATIC_LIBRARY_PREFIX@${library}@CMAKE_STATIC_LIBRARY_SUFFIX@")
endforeach()
foreach(header IN LISTS installed_headers)
    list(APPEND development_files "${include_directory}/jb/${header}")
endforeach()
set(documentation_files ${common_files} "${data_directory}/jobu/package/build-info-documentation.txt")
foreach(manual IN LISTS manuals)
    list(APPEND documentation_files "${documentation_directory}/${manual}")
endforeach()
foreach(manual IN LISTS protocol_manuals)
    list(APPEND documentation_files "${documentation_directory}/protocol/${manual}")
endforeach()

function(check_manifest destination expected)
    file(GLOB_RECURSE actual LIST_DIRECTORIES FALSE RELATIVE "${destination}" "${destination}/*")
    list(REMOVE_DUPLICATES expected)
    list(SORT actual)
    list(SORT expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "unexpected files in ${destination}\nactual=${actual}\nexpected=${expected}")
    endif()
endfunction()

# Inventory membership alone cannot catch stale or altered installed guidance.
# Compare maintained manuals and configured assets with their actual producer.
function(check_asset_bytes installed source)
    file(SHA256 "${installed}" installed_hash)
    file(SHA256 "${source}" source_hash)
    if(NOT installed_hash STREQUAL source_hash)
        message(FATAL_ERROR "Installed guidance differs from its source: ${installed}")
    endif()
endfunction()

function(check_documentation destination)
    foreach(manual IN LISTS manuals)
        check_asset_bytes("${destination}/${documentation_directory}/${manual}"
            "@PROJECT_SOURCE_DIR@/docs/${manual}")
    endforeach()
    foreach(manual IN LISTS protocol_manuals)
        check_asset_bytes("${destination}/${documentation_directory}/protocol/${manual}"
            "@PROJECT_SOURCE_DIR@/docs/protocol/${manual}")
    endforeach()
endfunction()

function(check_runtime_guidance destination generated_directory)
    check_asset_bytes("${destination}/${configuration_readme}" "${generated_directory}/configuration-README.md")
    check_asset_bytes("${destination}/${data_directory}/jobu/jobud.ini.example"
        "${generated_directory}/jobud.ini.example")
    check_asset_bytes("${destination}/${data_directory}/jobu/services/README.md"
        "@PROJECT_SOURCE_DIR@/docs/services/systemd.md")
endfunction()

function(read_metadata output path)
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Darwin")
        set(stat_arguments -f "%Lp:%u:%g")
    else()
        set(stat_arguments -c "%a:%u:%g")
    endif()
    execute_process(COMMAND stat ${stat_arguments} "${path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE metadata OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Cannot inspect ${path}: ${error}")
    endif()
    set(${output} "${metadata}" PARENT_SCOPE)
endfunction()

# File parents plus the contract's empty runtime leaves form the independent
# directory oracle. A generated package inventory is never the expected list.
function(check_directories destination expected_files layout)
    set(expected ${layout})
    foreach(path IN LISTS expected_files)
        get_filename_component(parent "${path}" DIRECTORY)
        while(NOT parent STREQUAL "" AND NOT parent STREQUAL ".")
            list(APPEND expected "${parent}")
            get_filename_component(parent "${parent}" DIRECTORY)
        endwhile()
    endforeach()
    list(REMOVE_DUPLICATES expected)
    list(SORT expected)

    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${destination}" "${destination}/*")
    set(actual "")
    foreach(path IN LISTS entries)
        if(IS_SYMLINK "${destination}/${path}")
            message(FATAL_ERROR "Unexpected installed symlink: ${path}")
        endif()
        if(IS_DIRECTORY "${destination}/${path}")
            list(APPEND actual "${path}")
        endif()
    endforeach()
    list(SORT actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected directories in ${destination}\nactual=${actual}\nexpected=${expected}")
    endif()
    foreach(path IN LISTS layout)
        set(mode 755)
        if(path STREQUAL "var/lib" OR path STREQUAL "var/run")
            set(mode 700)
        endif()
        read_metadata(metadata "${destination}/${path}")
        if(NOT metadata MATCHES "^${mode}:")
            message(FATAL_ERROR "Unexpected runtime directory metadata ${metadata}: ${path}; expected mode ${mode}")
        endif()
    endforeach()
endfunction()
