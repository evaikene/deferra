cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED fixture OR NOT DEFINED test_logs)
    message(FATAL_ERROR "Run through jobu-test-runner.cmake")
endif()
set(source [==[@PROJECT_SOURCE_DIR@]==])
set(fixture_source "${source}/test/systemd-fixture")

function(configure_profile name expected)
    set(build "${fixture}/${name}")
    if(name STREQUAL "cached-switch")
        set(build "${fixture}/custom")
    endif()
    execute_process(COMMAND "@CMAKE_COMMAND@" -S "${fixture_source}" -B "${build}" -G "@CMAKE_GENERATOR@"
        "-Djobu_source=${source}" -DJB_BUILD_SQLITE_DRIVER=ON ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${test_logs}/${name}-configure.log" "${output}\n${error}")
    if(expected STREQUAL "success")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${name} configuration failed: ${output}\n${error}")
        endif()
        if(EXISTS "${build}/jobu-generated/jobud.service")
            configure_file("${build}/jobu-generated/jobud.service" "${test_logs}/${name}.service" COPYONLY)
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "${name} did not reject with ${expected}: ${output}\n${error}")
    endif()
endfunction()

function(require_text contents expected)
    string(FIND "${contents}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing expected text: ${expected}")
    endif()
endfunction()

function(check_unit name directories executable config)
    file(READ "${fixture}/${name}/jobu-generated/jobud.service" unit)
    foreach(required "Type=exec" "User=jobu" "Group=jobu" "UMask=0077"
        "Restart=on-failure" "RestartSec=5" "StartLimitIntervalSec=60" "StartLimitBurst=5"
        "KillSignal=SIGTERM" "KillMode=mixed" "TimeoutStopSec=15" "SendSIGKILL=yes"
        "NoNewPrivileges=yes" "LimitCORE=0" "StandardOutput=journal" "StandardError=journal"
        "ExecStart=${executable} --config ${config}")
        require_text("${unit}" "${required}\n")
    endforeach()
    if(unit MATCHES "@[A-Za-z_][A-Za-z0-9_]*@|ExecStartPre=|PIDFile=|ExecReload=")
        message(FATAL_ERROR "${name} has a placeholder or unexpected startup/reload mechanism")
    endif()
    if(directories)
        foreach(required "RuntimeDirectory=jobu" "RuntimeDirectoryMode=0700" "StateDirectory=jobu" "StateDirectoryMode=0700")
            require_text("${unit}" "${required}\n")
        endforeach()
    elseif(unit MATCHES "(Runtime|State)Directory")
        message(FATAL_ERROR "Custom profile has system-managed directories")
    endif()
endfunction()

# Fresh profiles share paths with both applications and the exhaustive INI.
configure_profile(none success -DCMAKE_INSTALL_PREFIX=/opt/jobu -DJB_JOBU_SYSTEMD_PROFILE=none)
if(EXISTS "${fixture}/none/jobu-generated/jobud.service")
    message(FATAL_ERROR "The none profile generated a unit")
endif()
configure_profile(system success -DCMAKE_INSTALL_PREFIX=/usr -DJB_JOBU_SYSTEMD_PROFILE=system)
check_unit(system TRUE "\"/usr/bin/jobud\"" "\"/etc/jobu/jobud.ini\"")
file(READ "${fixture}/system/jobu-generated/jobud.ini.example" sample)
require_text("${sample}" "database.path = \"/var/lib/jobu/jobu.sqlite3\"")
require_text("${sample}" "socket.path = \"/run/jobu/jobud.sock\"")
file(READ "${fixture}/system/jobu-generated/jobu_paths_priv.hpp" paths)
foreach(expected /etc/jobu/jobud.ini /var/lib/jobu/jobu.sqlite3 /run/jobu/jobud.sock)
    require_text("${paths}" "${expected}")
endforeach()

configure_profile(custom success -DCMAKE_INSTALL_PREFIX=/opt/jobu -DJB_JOBU_SYSTEMD_PROFILE=custom)
check_unit(custom FALSE "\"/opt/jobu/bin/jobud\"" "\"/opt/jobu/etc/jobud.ini\"")
set(escaped_prefix [=[/opt/jobu space%tail]=])
set(escaped_config [=[/etc/jobu space%$'"\tail]=])
configure_profile(escaped success "-DCMAKE_INSTALL_PREFIX=${escaped_prefix}"
    "-DJB_JOBU_SYSCONFDIR:STRING=${escaped_config}"
    -DJB_JOBU_RUNDIR=/run/jobu-custom -DJB_JOBU_SYSTEMD_PROFILE=custom)
check_unit(escaped FALSE [=["/opt/jobu space%%tail/bin/jobud"]=]
    [=["/etc/jobu space%%$$'\"\\tail/jobud.ini"]=])
file(READ "${fixture}/escaped/jobu-generated/jobu_paths_priv.hpp" paths)
require_text("${paths}" [=[/etc/jobu space%$'\"\\tail/jobud.ini]=])
configure_profile(overrides success -DCMAKE_INSTALL_PREFIX=/opt/jobu -DJB_JOBU_SYSTEMD_PROFILE=custom
    -DCMAKE_INSTALL_BINDIR=sbin -DJB_JOBU_SYSCONFDIR=/etc/jobu-custom
    -DJB_JOBU_STATEDIR=/var/lib/jobu-custom -DJB_JOBU_RUNDIR=/run/jobu-custom)
check_unit(overrides FALSE "\"/opt/jobu/sbin/jobud\"" "\"/etc/jobu-custom/jobud.ini\"")

configure_profile(bad-profile "must be none, system, or custom" -DJB_JOBU_SYSTEMD_PROFILE=automatic)
configure_profile(bad-prefix "requires CMAKE_INSTALL_PREFIX=/usr" -DCMAKE_INSTALL_PREFIX=/opt/jobu -DJB_JOBU_SYSTEMD_PROFILE=system)
foreach(path SYSCONFDIR STATEDIR RUNDIR)
    configure_profile("bad-${path}" "requires JB_JOBU_${path}="
        -DCMAKE_INSTALL_PREFIX=/usr -DJB_JOBU_SYSTEMD_PROFILE=system "-DJB_JOBU_${path}=/opt/jobu")
endforeach()
configure_profile(bad-platform "requires Linux" -DCMAKE_SYSTEM_NAME=Darwin -DJB_JOBU_SYSTEMD_PROFILE=custom)
configure_profile(bad-backend "requires Linux" -DJB_BUILD_SQLITE_DRIVER=OFF -DJB_JOBU_SYSTEMD_PROFILE=custom)
configure_profile(bad-control "single-line path" -DJB_JOBU_SYSTEMD_PROFILE=custom "-DJB_JOBU_SYSCONFDIR=/opt/jobu\nunsafe")
configure_profile(bad-tab "no control characters" -DJB_JOBU_SYSTEMD_PROFILE=custom "-DJB_JOBU_SYSCONFDIR:STRING=/opt/jobu\tunsafe")
configure_profile(bad-list "no CMake list separators" -DJB_JOBU_SYSTEMD_PROFILE=custom "-DCMAKE_INSTALL_BINDIR=bin\;unsafe")
configure_profile(bad-install-quote "install destinations cannot contain quotes" -DJB_JOBU_SYSTEMD_PROFILE=custom
    [=[-DCMAKE_INSTALL_PREFIX=/opt/jobu"unsafe]=])
configure_profile(bad-install-expansion "install destinations cannot contain quotes" -DJB_JOBU_SYSTEMD_PROFILE=custom
    [=[-DCMAKE_INSTALL_PREFIX=/opt/${unsafe}]=])
configure_profile(bad-executable-dollar "executable destinations cannot contain dollar" -DJB_JOBU_SYSTEMD_PROFILE=custom
    [=[-DCMAKE_INSTALL_PREFIX=/opt/jobu$unsafe]=])
configure_profile(bad-executable-quote "executable destinations cannot contain dollar" -DJB_JOBU_SYSTEMD_PROFILE=custom
    [=[-DCMAKE_INSTALL_PREFIX=/opt/jobu'unsafe]=])
# A profile switch must not silently rewrite initialized operational cache values.
configure_profile(cached-switch "requires JB_JOBU_SYSCONFDIR=" -DCMAKE_INSTALL_PREFIX=/usr -DJB_JOBU_SYSTEMD_PROFILE=system)

# Runtime-only repeated and DESTDIR installs touch neither operator policy nor
# data. Their units retain configuration-time paths even at a staging prefix.
set(expected_data share/jobu/LICENSE share/jobu/THIRD_PARTY_NOTICES.md share/jobu/jobud.ini.example
    share/jobu/services/README.md share/jobu/services/jobud.service.in share/jobu/services/wait-ready.sh)
foreach(profile none system escaped)
    set(prefix "${fixture}/installed-${profile}")
    file(MAKE_DIRECTORY "${prefix}/etc")
    file(WRITE "${prefix}/etc/jobud.ini" "operator sentinel\n")
    foreach(pass RANGE 1 2)
        execute_process(COMMAND "@CMAKE_COMMAND@" --install "${fixture}/${profile}" --prefix "${prefix}" --component Runtime
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${profile} install failed: ${output}\n${error}")
        endif()
    endforeach()
    set(expected ${expected_data} etc/jobud.ini)
    if(profile STREQUAL "none")
        list(APPEND expected etc/README.md)
    else()
        list(APPEND expected share/jobu/configuration-README.md)
    endif()
    if(NOT profile STREQUAL "none")
        list(APPEND expected share/jobu/services/jobud.service)
        file(READ "${fixture}/${profile}/jobu-generated/jobud.service" original)
        file(READ "${prefix}/share/jobu/services/jobud.service" installed)
        if(NOT original STREQUAL installed)
            message(FATAL_ERROR "Install-time prefix changed the unit")
        endif()
    endif()
    if(profile STREQUAL "system")
        list(APPEND expected lib/systemd/system/jobud.service)
        file(READ "${prefix}/lib/systemd/system/jobud.service" vendor)
        if(NOT vendor STREQUAL original)
            message(FATAL_ERROR "Vendor/data unit mismatch")
        endif()
    endif()
    file(GLOB_RECURSE actual LIST_DIRECTORIES FALSE RELATIVE "${prefix}" "${prefix}/*")
    list(SORT actual)
    list(SORT expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${profile} payload mismatch: ${actual}\nexpected: ${expected}")
    endif()
    file(READ "${prefix}/etc/jobud.ini" sentinel)
    if(NOT sentinel STREQUAL "operator sentinel\n")
        message(FATAL_ERROR "Installation overwrote operator configuration")
    endif()
endforeach()
execute_process(COMMAND "@CMAKE_COMMAND@" -E env "DESTDIR=${fixture}/destdir" "@CMAKE_COMMAND@"
    --install "${fixture}/system" --prefix /usr --component Runtime
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "System-profile DESTDIR install failed: ${output}\n${error}")
endif()
file(READ "${fixture}/system/jobu-generated/jobud.service" original)
file(READ "${fixture}/destdir/usr/lib/systemd/system/jobud.service" staged)
if(NOT original STREQUAL staged)
    message(FATAL_ERROR "DESTDIR changed the unit")
endif()

# Offline parser fixtures use inert executable placeholders and minimal targets.
# No unit is loaded into the running manager and no JobU process is started.
find_program(systemd_analyze systemd-analyze)
foreach(profile system escaped)
    set(root "${fixture}/syntax-${profile}")
    set(units "${root}/usr/lib/systemd/system")
    file(MAKE_DIRECTORY "${units}" "${root}/var/lib/jobu" "${root}/run/jobu")
    file(COPY "${fixture}/${profile}/jobu-generated/jobud.service" DESTINATION "${units}")
    foreach(target basic sysinit shutdown network multi-user)
        file(WRITE "${units}/${target}.target" "[Unit]\nDescription=Syntax fixture\nDefaultDependencies=no\n")
    endforeach()
    if(profile STREQUAL "system")
        set(executable /usr/bin/jobud)
    else()
        set(executable "${escaped_prefix}/bin/jobud")
    endif()
    get_filename_component(parent "${root}${executable}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${root}${executable}" "")
    file(CHMOD "${root}${executable}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    if(systemd_analyze)
        execute_process(COMMAND "${systemd_analyze}" --root "${root}" --generators=no --man=no --recursive-errors=yes verify jobud.service
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        file(WRITE "${test_logs}/${profile}-verify.log" "${output}\n${error}")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${profile} unit verification failed: ${output}\n${error}")
        endif()
    endif()
endforeach()
if(NOT systemd_analyze)
    message(STATUS "systemd-analyze unavailable: native syntax verification remains pending")
endif()
# Preserve only these small fixtures for the native VM syntax gate.
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "${test_logs}/syntax-fixtures.tar" syntax-system syntax-escaped
    WORKING_DIRECTORY "${fixture}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not preserve syntax fixtures")
endif()
message(STATUS "Systemd profiles, rejection cases, path agreement and staged assets passed")
