cmake_minimum_required(VERSION 3.20)

set(producer_source [==[@PROJECT_SOURCE_DIR@]==])
set(parent_build [==[@PROJECT_BINARY_DIR@]==])
set(test_configuration Release)
include("@CMAKE_CURRENT_BINARY_DIR@/jobu-install-manifest.cmake")
foreach(directory binary_directory library_directory include_directory data_directory documentation_directory sdk_directory)
    if(IS_ABSOLUTE "${${directory}}" OR "${${directory}}" MATCHES "(^|/)[.][.](/|$)")
        message(STATUS "Unsupported package-test layout: ${directory} is not prefix-relative")
        return()
    endif()
endforeach()
if(NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" OR "@CMAKE_CROSSCOMPILING@")
    message(STATUS "Unsupported package-test layout: native Linux dependency inspection is required")
    return()
endif()
if("@JOBU_PACKAGE_MULTI_CONFIG@")
    message(STATUS "Unsupported package-test layout: multi-config producers are unsupported")
    return()
endif()

if(NOT DEFINED fixture OR NOT DEFINED test_logs)
    message(FATAL_ERROR "Run the package gate through jobu-test-runner.cmake")
endif()
set(producer "${fixture}/producer")
set(output "${fixture}/artifacts")
set(repeated_output "${fixture}/artifacts-repeated")

function(run_checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(WRITE "${test_logs}/${label}.log" "${output}\n${error}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${label} failed (${result}); evidence: ${fixture}\n${output}\n${error}")
    endif()
endfunction()

# The artifact producer never requires Catch2 or builds examples/test helpers.
# Reuse configured GNUInstallDirs so the independent expected manifest matches.
set(configure_arguments -S "${producer_source}" -B "${producer}" -G "@CMAKE_GENERATOR@"
    -C "@CMAKE_CURRENT_BINARY_DIR@/jobu-package-cache.cmake"
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/jobu
    -DJB_JOBU_SYSCONFDIR=/opt/jobu/etc -DJB_JOBU_STATEDIR=/opt/jobu/var/lib -DJB_JOBU_RUNDIR=/opt/jobu/var/run
    -DBUILD_TESTING=OFF -DJB_BUILD_EXAMPLES=OFF -DJB_PACKAGE_REMAP_PATHS=ON
    "-DJB_BUILD_SQLITE_DRIVER=@JB_BUILD_SQLITE_DRIVER@"
    "-DCMAKE_INSTALL_BINDIR=${binary_directory}" "-DCMAKE_INSTALL_LIBDIR=${library_directory}"
    "-DCMAKE_INSTALL_INCLUDEDIR=${include_directory}" "-DCMAKE_INSTALL_DATADIR=${data_directory}"
    "-DCMAKE_INSTALL_DOCDIR=${documentation_directory}")
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
    list(APPEND configure_arguments -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
    list(APPEND configure_arguments -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
run_checked(producer-configure "@CMAKE_COMMAND@" ${configure_arguments})
run_checked(producer-build "@CMAKE_COMMAND@" --build "${producer}" --config Release --parallel 2)
run_checked(package "@CMAKE_CPACK_COMMAND@" --config "${producer}/CPackConfig.cmake" -C Release -B "${output}")
run_checked(package-repeat "@CMAKE_CPACK_COMMAND@" --config "${producer}/CPackConfig.cmake" -C Release -B "${repeated_output}")

file(GLOB archives "${output}/*.tar.gz")
list(LENGTH archives archive_count)
if(NOT archive_count EQUAL 3)
    message(FATAL_ERROR "Expected three component archives; evidence: ${fixture}")
endif()
foreach(component runtime development documentation)
    file(GLOB matching "${output}/JobU-@PROJECT_VERSION@-Linux-*-@CMAKE_SYSTEM_PROCESSOR@-${component}.tar.gz")
    list(LENGTH matching count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Missing or ambiguous ${component} archive; evidence: ${fixture}")
    endif()
    list(GET matching 0 archive)
    get_filename_component(archive_name "${archive}" NAME)
    file(SHA256 "${archive}" archive_hash)
    file(READ "${archive}.sha256" checksum)
    if(NOT checksum MATCHES "^${archive_hash} +${archive_name}")
        message(FATAL_ERROR "Archive checksum does not match: ${archive}")
    endif()

    set(root "${fixture}/${component}")
    file(MAKE_DIRECTORY "${root}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${root}")
    set(expected ${${component}_files})
    check_manifest("${root}" "${expected}")
    file(STRINGS "${archive}.files.sha256" entries)
    set(inventoried)
    foreach(entry IN LISTS entries)
        string(REGEX MATCH "^([0-9a-f]+)  (.+)$" matched "${entry}")
        if(NOT matched)
            message(FATAL_ERROR "Malformed file inventory entry: ${entry}")
        endif()
        set(hash "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        file(SHA256 "${root}/${path}" actual_hash)
        if(NOT hash STREQUAL actual_hash)
            message(FATAL_ERROR "Payload checksum mismatch: ${path}")
        endif()
        list(APPEND inventoried "${path}")
    endforeach()
    check_manifest("${root}" "${inventoried}")
    file(READ "${root}/${data_directory}/jobu/package/build-info-${component}.txt" metadata)
    foreach(required "project-version=@PROJECT_VERSION@" "rpc-api-version=1.4"
        "build-configuration=Release" "tests-enabled=OFF" "examples-enabled=OFF"
        "producer-paths-remapped=ON" "dependency-shared-library-files-bundled=false")
        string(FIND "${metadata}" "${required}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "Missing build metadata: ${required}")
        endif()
    endforeach()
    if(component STREQUAL "runtime")
        foreach(required "Native runtime dependencies (external; shared-library files are not bundled)" ${applications})
            string(FIND "${metadata}" "${required}" position)
            if(position EQUAL -1)
                message(FATAL_ERROR "Missing Runtime dependency metadata: ${required}")
            endif()
        endforeach()
    endif()

    set(repeated_root "${fixture}/repeated-${component}")
    file(MAKE_DIRECTORY "${repeated_root}")
    file(ARCHIVE_EXTRACT INPUT "${repeated_output}/${archive_name}" DESTINATION "${repeated_root}")
    check_manifest("${repeated_root}" "${expected}")
    foreach(path IN LISTS expected)
        file(SHA256 "${root}/${path}" original_hash)
        file(SHA256 "${repeated_root}/${path}" repeated_hash)
        if(NOT original_hash STREQUAL repeated_hash)
            message(FATAL_ERROR "Repeated packaging changed payload: ${path}")
        endif()
        if(IS_SYMLINK "${root}/${path}")
            message(FATAL_ERROR "Unexpected package symlink: ${path}")
        endif()
        execute_process(COMMAND stat -c %a "${root}/${path}"
            RESULT_VARIABLE result OUTPUT_VARIABLE mode OUTPUT_STRIP_TRAILING_WHITESPACE)
        set(expected_mode 644)
        if(path MATCHES "^${binary_directory}/")
            set(expected_mode 755)
        endif()
        if(NOT result EQUAL 0 OR NOT mode STREQUAL expected_mode)
            message(FATAL_ERROR "Unexpected payload mode ${mode}: ${path} (expected ${expected_mode})")
        endif()
    endforeach()
endforeach()

# Extraction refreshes examples; neither it nor the package carries active
# operator policy/data. Keep sentinels across two overlays of the Runtime archive.
set(runtime "${fixture}/runtime")
foreach(path etc/jobud.ini var/lib/operator.sqlite3 var/run/operator.lock)
    get_filename_component(parent "${runtime}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(WRITE "${runtime}/${path}" "operator-owned sentinel\n")
endforeach()
file(GLOB runtime_archive "${output}/*-runtime.tar.gz")
file(ARCHIVE_EXTRACT INPUT "${runtime_archive}" DESTINATION "${runtime}")
file(ARCHIVE_EXTRACT INPUT "${runtime_archive}" DESTINATION "${runtime}")
foreach(path etc/jobud.ini var/lib/operator.sqlite3 var/run/operator.lock)
    file(READ "${runtime}/${path}" contents)
    if(NOT contents STREQUAL "operator-owned sentinel\n")
        message(FATAL_ERROR "Package extraction overwrote ${path}")
    endif()
endforeach()
foreach(application IN LISTS applications)
    run_checked("${application}-executable" test -x "${runtime}/${binary_directory}/${application}")
    run_checked("${application}-help" "${runtime}/${binary_directory}/${application}" --help)
    run_checked("${application}-version" "${runtime}/${binary_directory}/${application}" --version)
endforeach()
if("jobud" IN_LIST applications)
    run_checked(check-config "${runtime}/${binary_directory}/jobud" --check-config
        --config "${runtime}/${data_directory}/jobu/jobud.ini.example")
    # The existing bounded fixture checks real RPC versions, clean stop/reopen,
    # and format rejection with packaged executables supplied as arguments.
    set(smoke "${parent_build}/test/jobuctl-system-info-test@CMAKE_EXECUTABLE_SUFFIX@")
    if(NOT EXISTS "${smoke}")
        message(FATAL_ERROR "Build jobuctl-system-info-test before running the package gate")
    endif()
    run_checked(foreground "@CMAKE_COMMAND@" -E env TMPDIR=/tmp "${smoke}"
        "${runtime}/${binary_directory}/jobud" "${runtime}/${binary_directory}/jobuctl" "@PROJECT_VERSION@")
endif()
run_checked(archive-sdk "@CMAKE_COMMAND@" "-Dsdk_archive_prefix=${fixture}/development"
    "-Dsdk_archive_producer=${producer}" -Dtest_configuration=Release
    "-Dfixture=${fixture}/sdk" "-Dtest_logs=${test_logs}/archive-sdk"
    -P "@CMAKE_CURRENT_BINARY_DIR@/jobu-sdk-test.cmake")

set(saved_artifacts "${parent_build}/jobu-artifacts")
file(MAKE_DIRECTORY "${saved_artifacts}")
file(GLOB deliverables "${output}/*.tar.gz" "${output}/*.tar.gz.sha256" "${output}/*.tar.gz.files.sha256")
file(COPY ${deliverables} DESTINATION "${saved_artifacts}")
message(STATUS "Three component archives, repeated payloads, packaged runtime and extracted SDK passed")
message(STATUS "Validated archives, checksums and inventories saved in ${saved_artifacts}")
