{
  "queue_name": "reports",
  "type": "cli",
  "schedule": {"kind": "once", "at": "now"},
  "payload": {
    "command": "/usr/local/bin/report",
    "arguments": ["--token", {"secret": "reports.token"}, "--mode", "daily"],
    "environment": {
      "MODE": "daily",
      "REPORT_PASSWORD": {"secret": "reports.password"}
    }
  }
}
