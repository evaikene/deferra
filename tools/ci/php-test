#!/bin/sh
set -eu

if [ "$#" -ne 3 ] && [ "$#" -ne 4 ]; then
    echo 'Usage: tools/ci/php-test VERSION PHP_CONFIG BUILD_DIRECTORY [JOBU_SDK_PREFIX]' >&2
    exit 2
fi
version=$1
php_config=$2
build=$3
php_binary=$("$php_config" --php-binary)
actual=$("$php_binary" -n -r 'echo PHP_MAJOR_VERSION, ".", PHP_MINOR_VERSION;')
if [ "$actual" != "$version" ]; then
    echo "Expected PHP $version, got $actual from $php_binary" >&2
    exit 1
fi
"$php_binary" -n -r 'printf("PHP %s, ZTS=%d, debug=%d, integer=%d bytes\n", PHP_VERSION, PHP_ZTS, PHP_DEBUG, PHP_INT_SIZE); exit(PHP_ZTS || PHP_INT_SIZE != 8 ? 1 : 0);'

# Both entry points rebuild only PHP-dependent code. When testing the module,
# the caller supplies the matching native SDK from this workflow run.
source=src/php-cxx
module=0
if [ "$#" -eq 4 ]; then
    sdk=$(realpath "$4")
    daemon=$(realpath "$sdk/../fixtures/jobud")
    if [ ! -x "$daemon" ]; then
        echo "Missing same-build daemon fixture: $daemon" >&2
        exit 1
    fi
    source=src/jobu-php
    module=1
    cmake -S "$source" -B "$build" -G Ninja -DCMAKE_BUILD_TYPE=Debug \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DPHP_CONFIG="$php_config" \
        -DPHPCXX_REQUIRE_EMBED=ON -DCMAKE_PREFIX_PATH="$sdk" -DJOBU_PHP_TEST_DAEMON="$daemon"
else
    cmake -S "$source" -B "$build" -G Ninja -DCMAKE_BUILD_TYPE=Debug \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DPHP_CONFIG="$php_config" -DPHPCXX_REQUIRE_EMBED=ON
fi
ccache --zero-stats
cmake --build "$build" --parallel 2
ccache --show-stats
ctest --test-dir "$build/test" --output-on-failure --no-tests=error --output-junit results.xml -LE '^distribution$'

# A green CTest exit permits skips. CI promises execution, including Embed and
# relocated consumers, so inspect results as well as the process exit status.
python3 - "$build/test/results.xml" "$module" <<'PY'
import sys
import xml.etree.ElementTree as ET

root = ET.parse(sys.argv[1]).getroot()
cases = root.findall('.//testcase')
required = {
    'php-cxx-build-test', 'php-cxx-module-test', 'php-cxx-conversion-consumer-test',
    'php-cxx-object-consumer-test', 'php-cxx-build-contract-test', 'php-cxx-install-layout-test',
    'php-cxx-ownership-test', 'php-cxx-conversion-test', 'php-cxx-object-test',
    'php-cxx-lifecycle-test', 'php-cxx-bailout-isolation-test', 'php-cxx-fatal-isolation-test',
}
if sys.argv[2] == '1':
    required.update({
        'jobu-php-configure-test',
        'jobu-php-module-test', 'jobu-php-reflection-test',
        'jobu-php-exceptions-test', 'jobu-php-restart-test', 'jobu-php-lifecycle-test',
        'jobu-php-client-test', 'jobu-php-bridge-test', 'jobu-php-values-test', 'jobu-php-attributes-test', 'jobu-php-cli-payload-test',
    })
missing = required - {case.get('name') for case in cases}
skipped = [case.get('name') for case in cases if case.find('skipped') is not None]
if missing or skipped:
    raise SystemExit(f'Missing required checks: {sorted(missing)}; skipped checks: {skipped}')
print(f'All {len(cases)} PHP checks executed without skips.')
PY
