@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(JobU_VERSION "@PROJECT_VERSION@")
set(_JobU_installed_components "@JOBU_SDK_COMPONENTS@")

# This order is topological. Component selection controls dependency discovery;
# loading Core must not even search for optional backends or producer-only JSON.
set(_JobU_components Core Net Db Rpc Jobu Client SQLite HTTP CLI)
set(_JobU_dependencies_Core "")
set(_JobU_dependencies_Net Core)
set(_JobU_dependencies_Db Core)
set(_JobU_dependencies_Rpc Core)
set(_JobU_dependencies_Jobu Core Net Db Rpc)
set(_JobU_dependencies_Client Jobu Rpc)
set(_JobU_dependencies_SQLite Db Jobu)
set(_JobU_dependencies_HTTP Net Jobu)
set(_JobU_dependencies_CLI Jobu Core)

# find_dependency returns from this function on failure. Mark the component
# unsuccessful first, then publish success only after all discovery/normalization.
# Do not forward REQUIRED: check_required_components below owns package failure,
# including when a caller requests an unavailable OPTIONAL_COMPONENTS backend.
function(_jobu_find_external_dependencies component)
    set(_JobU_external_found FALSE PARENT_SCOPE)
    set(JobU_FIND_REQUIRED FALSE)
    if(component STREQUAL "Core")
        set(_JobU_external_reason "Core requires fmt (CONFIG)" PARENT_SCOPE)
        find_dependency(fmt CONFIG)
    elseif(component STREQUAL "SQLite")
        set(_JobU_external_reason "SQLite requires SQLite3" PARENT_SCOPE)
        find_dependency(SQLite3)
        if(NOT TARGET SQLite3::SQLite3 AND TARGET SQLite::SQLite3)
            add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
        endif()
    elseif(component STREQUAL "HTTP")
        set(_JobU_external_reason "HTTP requires CURL 7.85 or newer" PARENT_SCOPE)
        find_dependency(CURL 7.85)
    endif()
    set(_JobU_external_found TRUE PARENT_SCOPE)
endfunction()

set(JobU_FOUND TRUE)
unset(JobU_NOT_FOUND_MESSAGE)
if(NOT JobU_FIND_COMPONENTS)
    set(JobU_FIND_COMPONENTS Core)
    set(JobU_FIND_REQUIRED_Core TRUE)
endif()

# Recompute each call so Core followed by Client (or a failed optional lookup
# followed by a later successful lookup) does not leave stale component results.
foreach(_JobU_component IN LISTS _JobU_components JobU_FIND_COMPONENTS)
    set(JobU_${_JobU_component}_FOUND FALSE)
endforeach()
set(_JobU_pending ${JobU_FIND_COMPONENTS})
set(_JobU_selected)
set(_JobU_failures)
while(_JobU_pending)
    list(POP_FRONT _JobU_pending _JobU_component)
    if(_JobU_component IN_LIST _JobU_selected)
        continue()
    endif()
    list(APPEND _JobU_selected "${_JobU_component}")
    if(NOT _JobU_component IN_LIST _JobU_components)
        list(APPEND _JobU_failures "Unknown JobU component: ${_JobU_component}")
        continue()
    endif()
    list(APPEND _JobU_pending ${_JobU_dependencies_${_JobU_component}})
endwhile()

foreach(_JobU_component IN LISTS _JobU_components)
    if(NOT _JobU_component IN_LIST _JobU_selected)
        continue()
    endif()
    if(NOT _JobU_component IN_LIST _JobU_installed_components OR
       NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/JobU${_JobU_component}Targets.cmake")
        list(APPEND _JobU_failures "JobU component ${_JobU_component} was not built or installed")
        continue()
    endif()

    set(_JobU_dependencies_found TRUE)
    foreach(_JobU_dependency IN LISTS _JobU_dependencies_${_JobU_component})
        if(NOT JobU_${_JobU_dependency}_FOUND)
            set(_JobU_dependencies_found FALSE)
        endif()
    endforeach()
    if(NOT _JobU_dependencies_found)
        list(APPEND _JobU_failures "JobU component ${_JobU_component} has unavailable dependencies")
        continue()
    endif()

    _jobu_find_external_dependencies("${_JobU_component}")
    if(NOT _JobU_external_found)
        list(APPEND _JobU_failures "${_JobU_external_reason}")
        continue()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/JobU${_JobU_component}Targets.cmake")
    set(JobU_${_JobU_component}_FOUND TRUE)
endforeach()

check_required_components(JobU)
if(NOT JobU_FOUND)
    list(JOIN _JobU_failures "; " JobU_NOT_FOUND_MESSAGE)
endif()
