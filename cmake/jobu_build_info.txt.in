package=JobU
component=@JOBU_PACKAGE_COMPONENT@
project-version=@PROJECT_VERSION@
rpc-api-version=1.4
source-revision=@JOBU_PACKAGE_SOURCE_REVISION@
source-state=@JOBU_PACKAGE_SOURCE_STATE@
target-os=@JOBU_PACKAGE_OS@
target-architecture=@CMAKE_SYSTEM_PROCESSOR@
compiler=@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@
cxx-standard=@CMAKE_CXX_STANDARD@
c-runtime=@JOBU_PACKAGE_RUNTIME@
cxx-runtime=@JOBU_PACKAGE_CXX_RUNTIME@
build-configuration=@CMAKE_BUILD_TYPE@
sqlite-enabled=@JB_BUILD_SQLITE_DRIVER@
tests-enabled=@BUILD_TESTING@
examples-enabled=@JB_BUILD_EXAMPLES@
producer-paths-remapped=@JB_PACKAGE_REMAP_PATHS@
reusable-libraries=static, PIC; compatible C++ runtime and dependency development files required
fmt-version=@JOBU_PACKAGE_FMT_VERSION@
nlohmann-json-version=@JOBU_PACKAGE_JSON_VERSION@
libcurl-version=@JOBU_PACKAGE_CURL_VERSION@
sqlite-version=@JOBU_PACKAGE_SQLITE_VERSION@
dependency-shared-library-files-bundled=false
configured-install-prefix=@CMAKE_INSTALL_PREFIX@
configured-config-directory=@JB_JOBU_SYSCONFDIR@
configured-state-directory=@JB_JOBU_STATEDIR@
configured-runtime-directory=@JB_JOBU_RUNDIR@
portability=producer platform/toolchain only; this metadata is not deployment verification
